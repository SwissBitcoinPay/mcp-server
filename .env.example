# Copy to .env to run docker-compose.yml yourself (deploy/ writes /etc/sattleme-mcp/mcp.env instead).
# The server's public host name: a DNS name pointing to this machine. Clients and tokens are bound to
# it: changing it later means every merchant connects again.
PUBLIC_HOST=mcp.example.com

# Required, secret: 32 random bytes or more, base64url. Seals clients, codes and tokens; changing it
# ends them all. Make it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_SEAL_SECRET=

# Optional (docs/HOSTING.md, Configuration):
# MCP_TIME_ZONE=Europe/Zurich
# MCP_LANGUAGE=fr
# MCP_ALLOWED_REDIRECTS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
